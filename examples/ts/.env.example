# Copy to .env and `source .env` (or export these in your shell).
# The invoker is the transaction source; it is NOT a named role in the escrow.
export RPC_URL=https://soroban-testnet.stellar.org
export NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
export CONTRACT_ID=<deployed harvestlock escrow contract id>

export BUYER_SECRET=<buyer S... secret>
export COOPERATIVE_SECRET=<cooperative S... secret>
export INVOKER_SECRET=<funded source-account S... secret>
