# Pinned serialized shape of every escrow event (issue #214).
#
# Each line is one #[contractevent]: its topic-0 name, the full topic
# list in order, and the data map with key order preserved. Addresses
# are shown as `Address` because their values are per-instance; every
# other value (symbol names, enum discriminants, integers, booleans)
# is pinned literally.
#
# A change to this file is an event-shape change: per docs/versioning.md
# section 2 it is a MINOR **BREAKING** bump, and downstream decoders
# must be updated. Regenerate with:
#
#   BLESS_EVENTS_SNAPSHOT=1 cargo test -p harvestlock-escrow --test events_snapshot
#
status_changed topics=[Symbol(status_changed), Vec([Symbol(Draft)]), Vec([Symbol(Locked)])] data=Void
payout topics=[Symbol(payout), Symbol(coop_pay)] data=Map({Symbol(amount): I128(0,1000), Symbol(to): Address})
tranche_claimed topics=[Symbol(tranche_claimed), U32(1)] data=Map({Symbol(amount): I128(0,150000), Symbol(to): Address})
tranche_reclaimed topics=[Symbol(tranche_reclaimed), U32(2)] data=Map({Symbol(amount): I128(0,150000), Symbol(to): Address})
remainder_funded topics=[Symbol(remainder_funded)] data=Map({Symbol(amount): I128(0,700000), Symbol(from): Address})
fx_shortfall_funded topics=[Symbol(fx_shortfall_funded)] data=Map({Symbol(amount): I128(0,334000), Symbol(from): Address})
buyer_reassigned topics=[Symbol(buyer_reassigned), Address, Address] data=Map({})
dispute_flagged topics=[Symbol(dispute_flagged), Address] data=Map({Symbol(deadline): U64(604800), Symbol(pre_status): Vec([Symbol(Locked)])})
dispute_ended topics=[Symbol(dispute_ended), Vec([Symbol(Resolved)])] data=Map({Symbol(restored): Vec([Symbol(Locked)])})
fx_resolved topics=[Symbol(fx_resolved)] data=Map({Symbol(deadline): U64(604800), Symbol(fx_adjusted_total): I128(0,1334000), Symbol(rate): I128(0,66700000000), Symbol(rate_timestamp): U64(1), Symbol(shortfall): I128(0,334000)})
fx_quote_stale_changed topics=[Symbol(fx_quote_stale_changed)] data=Bool(true)
delivery_confirmed topics=[Symbol(delivery_confirmed), U32(0)] data=Map({Symbol(delivered_quantity): U32(500), Symbol(settlement_bps): U32(5000)})
allocation_recorded topics=[Symbol(allocation_recorded)] data=Map({Symbol(member_count): U32(2), Symbol(total_share_bps): U32(10000)})
oracle_config_replaced topics=[Symbol(oracle_config_replaced)] data=Map({Symbol(new_oracle_contract): Address})
